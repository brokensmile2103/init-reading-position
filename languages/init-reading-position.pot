#: includes/settings-page.php:186
msgid "Content area selector"
msgstr ""

#: includes/settings-page.php:197
msgid "Optional. Enter a CSS selector that defines where reading progress is tracked."
msgstr ""

#: includes/settings-page.php:205
msgid "Auto-clear saved position at content end"
msgstr ""

#: includes/settings-page.php:215
msgid "Automatically remove the saved reading position when the reader reaches the end of the content area."
msgstr ""

#: includes/settings-page.php:222
msgid "Clean up abandoned progress"
msgstr ""

#: includes/settings-page.php:231
msgid "Periodically delete individual reading positions that are both old and barely started."
msgstr ""

#. translators: 1: number of days input field, 2: percent input field
#: includes/settings-page.php:238
#, php-format
msgid "Delete a saved position when it has not been updated in at least %1$s days AND its progress is below %2$s%%."
msgstr ""

#: includes/settings-page.php:247
msgid "Only rows matching both conditions are removed — a position with high progress is kept even if very old, since the reader may still return to finish it."
msgstr ""

#: includes/settings-page.php:254
msgid "Clean up inactive accounts"
msgstr ""

#: includes/settings-page.php:263
msgid "Periodically delete ALL saved reading positions belonging to accounts that have not read anything in a long time."
msgstr ""

#. translators: %s: number of days input field
#: includes/settings-page.php:270
#, php-format
msgid "A user is considered inactive when none of their reading positions (on any post) have been updated in at least %s days."
msgstr ""

#: includes/settings-page.php:278
msgid "This is separate from the option above — it looks at the account as a whole, not a single post, and removes every saved position for that account, regardless of how much progress was made."
msgstr ""

